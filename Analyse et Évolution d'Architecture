\subsubsection{1. Prédiction de Charge (LSTM)}

\begin{tcolorbox}[
    enhanced,
    colback=info!5,
    colframe=info,
    title={\faBrain\ Algorithm 2: Prédiction de Charge par LSTM},
    fonttitle=\bfseries\color{white},
    coltitle=white,
    colbacktitle=info,
    arc=3mm,
    boxrule=2pt,
    breakable
]
\begin{algorithmic}[1]
\State \textbf{Input:} Série temporelle $X = \{x_1, ..., x_t\}$ (charge historique)
\State \textbf{Output:} Prédiction $\hat{x}_{t+1}, ..., \hat{x}_{t+h}$
\State
\State Initialiser LSTM: $h_0, c_0 \gets 0$
\For{$i = 1$ to $t$}
    \State $f_i = \sigma(W_f \cdot [h_{i-1}, x_i] + b_f)$ \Comment{\textcolor{secondary}{Forget gate}}
    \State $i_i = \sigma(W_i \cdot [h_{i-1}, x_i] + b_i)$ \Comment{\textcolor{secondary}{Input gate}}
    \State $\tilde{c}_i = \tanh(W_c \cdot [h_{i-1}, x_i] + b_c)$
    \State $c_i = f_i \odot c_{i-1} + i_i \odot \tilde{c}_i$
    \State $o_i = \sigma(W_o \cdot [h_{i-1}, x_i] + b_o)$ \Comment{\textcolor{secondary}{Output gate}}
    \State $h_i = o_i \odot \tanh(c_i)$
\EndFor
\State
\State \Return \textcolor{success}{Prédiction via couche dense:} $\hat{x}_{t+k} = W_{out} \cdot h_t + b_{out}$
\end{algorithmic}
\end{tcolorbox}

\subsubsection{2. Routage Intelligent (Q-Learning)}

État: $s = (load_1, ..., load_k, latency_1, ..., latency_k)$

Action: $a \in \{1, ..., k\}$ (choix du worker)

Récompense: $r = -\text{latency}_{actual}$

\begin{equation}
Q(s,a) \leftarrow Q(s,a) + \alpha \left[ r + \gamma \max_{a'} Q(s', a') - Q(s,a) \right]
\end{equation}

\begin{lstlisting}[language=Python, caption=Router Intelligent avec RL]
import numpy as np
from collections import defaultdict

class IntelligentRouter:
    def __init__(self, num_workers, alpha=0.1, gamma=0.95):
        self.Q = defaultdict(lambda: np.zeros(num_workers))
        self.alpha = alpha
        self.gamma = gamma
        self.epsilon = 0.1  # exploration
        
    def select_worker(self, state):
        if np.random.random() < self.epsilon:
            return np.random.randint(len(self.Q[state]))
        else:
            return np.argmax(self.Q[state])
    
    def update(self, state, action, reward, next_state):
        best_next = np.max(self.Q[next_state])
        td_target = reward + self.gamma * best_next
        td_error = td_target - self.Q[state][action]
        self.Q[state][action] += self.alpha * td_error
\end{lstlisting}

\subsubsection{3. Cache Prédictif (Collaborative Filtering)}

Prédire les requêtes futures par similarité utilisateur:
\begin{equation}
\text{score}(u, q) = \sum_{v \in N(u)} \text{sim}(u, v) \cdot r_{v,q}
\end{equation}

où $\text{sim}(u,v) = \frac{\sum_{i} r_{u,i} \cdot r_{v,i}}{\sqrt{\sum_i r_{u,i}^2} \cdot \sqrt{\sum_i r_{v,i}^2}}$

