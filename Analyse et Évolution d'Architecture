\subsubsection{Architecture Logicielle}

\begin{lstlisting}[language=Python, caption=Implémentation Gateway Local]
import asyncio
from fastapi import FastAPI
from functools import lru_cache

class LocalGateway:
    def __init__(self, num_workers=4):
        self.workers = [
            InferenceWorker(gpu_id=i) 
            for i in range(num_workers)
        ]
        self.l1_cache = LRUCache(maxsize=1000)
        self.router = LoadBalancer(self.workers)
        
    @lru_cache(maxsize=10000)
    async def process_request(self, prompt: str):
        # Check L1 cache
        if cached := self.l1_cache.get(prompt):
            return cached
            
        # Route to least loaded worker
        worker = self.router.select_worker()
        result = await worker.infer(prompt)
        
        # Update cache
        self.l1_cache.set(prompt, result)
        return result
\end{lstlisting}

