\begin{equation}
S(k) = \frac{1}{(1-p) + \frac{p}{k}}
\end{equation}

Pour DeepSeek avec $p = 0.95$ (95\% parallélisable):
\begin{align}
S_{théorique}(100) &= \frac{1}{0.05 + 0.0095} = 16.8 \\
S_{observé} &= \frac{1250}{100} = 12.5 \quad \text{(efficacité: 74\%)}
\end{align}

\subsection{Preuve d'Optimalité du Load Balancing}

\begin{theorem}[Least Connections Optimal]
L'algorithme "least\_conn" utilisé par NGINX (Annexe B.2) minimise le temps moyen de réponse lorsque les requêtes ont des durées variables.
\end{theorem}

\begin{proof}
Soit $n_i(t)$ le nombre de connexions sur le serveur $i$ à l'instant $t$.
La stratégie optimale minimise:
\begin{equation}
\mathbb{E}[T] = \sum_{i=1}^k p_i \cdot \mathbb{E}[T_i | n_i]
\end{equation}

L'algorithme least-conn assigne: $j^* = \arg\min_i n_i(t)$

Par inégalité de Jensen et convexité de $\mathbb{E}[T_i|n_i]$:
\begin{equation}
\mathbb{E}[T_{least\_conn}] \leq \mathbb{E}[T_{random}] \leq \mathbb{E}[T_{round\_robin}]
\end{equation}
\end{proof}

